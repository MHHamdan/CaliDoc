  "cards": [
    {
      "dot": "cyan",
      "title": "What is formally guaranteed",
      "items": [
        "Expected per-document fraction of missed gold fields ≤ α on a fresh document (pooled threshold)",
        "Same bound per field type only for types with ≥ m0 calibration spans; fallback types inherit the pooled bound",
        "Full-span coverage and CovGap are empirical summaries, not the guarantee"
      ]
    },
    {
      "dot": "rose",
      "title": "What the audit assumes",
      "items": [
        "Raw p-value rests on within-span positional exchangeability and cross-span independence",
        "Holm controls FWER across fields; it does not repair a single raw p-value",
        "Document-blocked bootstrap corroborates under weaker assumptions; a finding is claimed only when both agree",
        "Spans of length ≤ 2 carry no positional information (blind spot)"
      ]
    }
  ]
}