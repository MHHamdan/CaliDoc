{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "CaliDoc: field-level conformal risk control and boundary-escape annotation audit",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/architecture/calidoc_architecture.html",
    "legend": {
      "entries": {
        "external": {
          "label": "Input (given)"
        },
        "backend": {
          "label": "Post-hoc computation on cached probabilities"
        },
        "messagebus": {
          "label": "Calibrated threshold"
        },
        "frontend": {
          "label": "Delivered object"
        },
        "security": {
          "label": "Statistical control / assumption"
        },
        "cloud": {
          "label": "Independent evidence"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "extract",
      "label": "Extractor (fixed; not a contribution)"
    },
    {
      "id": "calib",
      "label": "SpanCRC calibration (document = exchangeable unit)"
    },
    {
      "id": "audit",
      "label": "Boundary-escape audit (same threshold)"
    },
    {
      "id": "repair",
      "label": "Repair lineage (SROIE case study)"
    }
  ],
  "mainPath": [
    "doc",
    "tagger",
    "nonconf",
    "spanscore",
    "risk",
    "crc_pooled",
    "output"
  ],
  "nodes": [
    {
      "id": "doc",
      "lane": "extract",
      "col": 0,
      "type": "external",
      "label": "Document",
      "sublabel": "OCR words + gold BIO",
      "icon": "none",
      "width": 146
    },
    {
      "id": "tagger",
      "lane": "extract",
      "col": 1,
      "type": "backend",
      "label": "LayoutLMv3 tagger",
      "sublabel": "argmax decoding kept",
      "icon": "none",
      "width": 146
    },
    {
      "id": "nonconf",
      "lane": "extract",
      "col": 2,
      "type": "backend",
      "label": "Token score",
      "sublabel": "1 − p(g_i | x_i), temp. T",
      "icon": "none",
      "width": 146
    },
    {
      "id": "spans",
      "lane": "calib",
      "col": 0,
      "type": "backend",
      "label": "Gold field spans",
      "sublabel": "BIO segments (a, b, t)",
      "icon": "none",
      "width": 146
    },
    {
      "id": "spanscore",
      "lane": "calib",
      "col": 2,
      "type": "backend",
      "label": "Max-token score",
      "sublabel": "S(s) = max_i 1 − p(g_i | x_i)",
      "tag": "S(s) ≤ λ iff covered",
      "icon": "none",
      "width": 146
    },
    {
      "id": "risk",
      "lane": "calib",
      "col": 3,
      "type": "backend",
      "label": "Field-miss R_j(λ)",
      "sublabel": "fraction missed in doc. j",
      "icon": "none",
      "width": 146
    },
    {
      "id": "crc_pooled",
      "lane": "calib",
      "col": 4,
      "type": "messagebus",
      "label": "Pooled SpanCRC λ̂",
      "sublabel": "E[R_{n+1}(λ̂)] ≤ α; Eq. 3",
      "tag": "formal bound",
      "yOffset": 62,
      "icon": "none",
      "width": 146
    },
    {
      "id": "crc_field",
      "lane": "calib",
      "col": 4,
      "type": "messagebus",
      "label": "Field-conditional λ̂_t",
      "sublabel": "≥ m0 = 25 spans, else pooled",
      "tag": "per-type bound if supported",
      "yOffset": -62,
      "icon": "none",
      "width": 160
    },
    {
      "id": "output",
      "lane": "calib",
      "col": 5,
      "type": "frontend",
      "label": "Reliability output",
      "sublabel": "candidate sets; risk ≤ α",
      "tag": "full-span cov.: empirical",
      "icon": "none",
      "width": 146
    },
    {
      "id": "escape",
      "lane": "audit",
      "col": 1,
      "type": "backend",
      "label": "Escape set E(s)",
      "sublabel": "τ = λ̂; 0 < k_s < L_s only",
      "icon": "none",
      "width": 146
    },
    {
      "id": "wstat",
      "lane": "audit",
      "col": 2,
      "type": "backend",
      "label": "Edge statistic W_t",
      "sublabel": "escapes at span edges",
      "icon": "none",
      "width": 146
    },
    {
      "id": "null",
      "lane": "audit",
      "col": 3,
      "type": "security",
      "label": "Randomization null",
      "sublabel": "given (L_s, k_s); B = 5,000",
      "tag": "cross-span independence",
      "yOffset": -62,
      "icon": "none",
      "width": 146
    },
    {
      "id": "boot",
      "lane": "audit",
      "col": 3,
      "type": "security",
      "label": "Blocked bootstrap",
      "sublabel": "documents resampled; 90% CI",
      "tag": "corroborative only",
      "yOffset": 62,
      "icon": "none",
      "width": 146
    },
    {
      "id": "holm",
      "lane": "audit",
      "col": 4,
      "type": "security",
      "label": "Holm FWER control",
      "sublabel": "eligible fields; BH, BY shown",
      "yOffset": -62,
      "icon": "none",
      "width": 146
    },
    {
      "id": "hypothesis",
      "lane": "audit",
      "col": 5,
      "type": "frontend",
      "label": "Audit hypothesis",
      "sublabel": "field + modal escape label",
      "tag": "needs both to agree",
      "icon": "none",
      "width": 146
    },
    {
      "id": "realign",
      "lane": "repair",
      "col": 4,
      "type": "cloud",
      "label": "Re-alignment check",
      "sublabel": "Task-3 strings vs OCR",
      "icon": "none",
      "width": 146
    },
    {
      "id": "validate",
      "lane": "repair",
      "col": 5,
      "type": "backend",
      "label": "Repair validation",
      "sublabel": "separate lineage; signal gone",
      "icon": "none",
      "width": 146
    }
  ],
